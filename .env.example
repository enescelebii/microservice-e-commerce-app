# Create a .env file based on this example and fill in the required values.
# DO NOT COMMIT YOUR .env FILE TO VERSION CONTROL (it may contain sensitive information).


KEYCLOAK_ADMIN=admin
# Change the default password for the Keycloak admin user (default is 'admin')
# Recommended: at least 12 characters.
KEYCLOAK_ADMIN_PASSWORD=<CHANGE_ME>

# Generate a strong secret for securing microservices API communication.
# Linux/macOS: openssl rand -base64 32
# Windows PowerShell:
#  [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
# Note: keep it unquoted (no "..." or '...') unless you really need quotes.
MICRO_SERVICES_API_SECRET=<GENERATE_A_SECRET>